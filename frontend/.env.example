# Frontend Environment Variables Template
# Copy this to .env.local and fill in with actual values

# API Configuration
VITE_API_BASE_URL=http://localhost:4000

# Network Configuration
VITE_NETWORK=testnet

# Algorand Node Configuration (optional, can use default)
VITE_ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
VITE_ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
# Notes:
# 1. VITE_API_BASE_URL points to the backend server
# 2. VITE_NETWORK should match backend configuration
# 3. Frontend auto-loads from backend if node URLs not specified
